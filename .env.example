# Copy to .env for local runs (.env is gitignored). Heroku uses `heroku config:set`.
# None of these are required locally — every one has a safe dev default in code.

# Pathway flow-editor (/admin) login password. Prod: generate, e.g. `openssl rand -hex 12`.
ADMIN_PASSWORD=dev-admin-pass

# HMAC key that signs the hk_admin session cookie. Prod: `openssl rand -hex 32`.
ADMIN_SECRET=dev-admin-secret-change-me

# LLM edge implementation. "stub" is the only wired value.
HEKIMYOL_LLM=stub

# Database. Local default is sqlite:///hekimyol.db. Heroku Postgres sets this for you.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
